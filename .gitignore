# --- Project data -----------------------------------------------------------
# Source PDFs and everything extracted from them stay local: they are large,
# they are republished by the ECI anyway, and users bring their own.
*.pdf
*.csv
*.xlsx
*.xls

# Raw screenshots; the one the app uses is committed as sample_format.png.
Screenshot*.png

# Keep the sample-format image -- app.py renders it on the upload screen.
!sample_format.png

# LibreOffice / Excel lock files
.~lock.*#
~$*

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.python-version

